// =============================================================================
// build.csando - ANDO CLI Build and Release Script
//
// Profiles:
// - (default): Build and test the CLI, build Ando.Server and its test project,
//   run server unit tests (always), run server integration tests + E2E
//   (SQL Server and PostgreSQL) when Docker is available, publish executables,
//   create NuGet package
// - publish: Also pushes to NuGet.org, container registry, creates GitHub release with binaries, and deploys docs.
//   Requires the full server integration + E2E matrix: fails if Docker is unavailable.
// - docs: Deploy the documentation website to Cloudflare (run `ando docs` first to generate API docs)
// - e2e: Force server tests and E2E tests to run (even on Ando.Server)
//   The Ando.Server project for this repo runs `e2e`, not `publish`: the server
//   verifies every push, and releases (NuGet, GHCR image, GitHub release,
//   website) are published locally with `ando run -p publish --dind`.
//
// Usage:
//   ando                 # Build and test (E2E tests run locally, skipped on server)
//   ando --dind -p publish  # Build, test (full matrix, Docker required), push to NuGet.org + container registry + deploy docs
//   ando docs            # Generate API docs (pre-hook) + update docs with Claude
//   ando -p docs         # Deploy docs to Cloudflare (skips build/test)
//   ando -p e2e          # Force server tests and E2E tests to run
//   ando -p publish,e2e  # Publish profile with forced E2E tests
//
// Gates:
//   1. Always (no Docker): build Ando.Server + Ando.Server.Tests (not in Ando.sln)
//      and run the server unit tests (`Category!=Integration`), including the EF
//      migration drift tests for both providers.
//   2. Docker gate: server integration tests (`Category=Integration`, Testcontainers,
//      SQL Server and PostgreSQL; ANDO_TEST_DB_PROVIDERS defaults to both),
//      then E2E against SQL Server (`npm test`) and PostgreSQL (`npm run test:postgres`).
//      Runs locally by default; skipped on Ando.Server unless -p e2e (the server
//      environment may not support nested container orchestration).
//   3. publish profile: the Docker gate is mandatory. Without Docker the build
//      fails instead of skipping (a release must not ship untested).
//
// Prerequisites:
// - NUGET_API_KEY env var set (or enter when prompted) for publish profile
// - Run `ando bump` before publish to set the desired version
// - Run `ando docs` before publish/docs profile to generate API documentation
// - For E2E tests: Run with `ando --dind` to enable Docker-in-Docker
//
// Output:
// - dist/{runtime}/ando[.exe] - Platform-specific executables
// - dist/packages/*.nupkg     - NuGet package for dotnet tool install
// - ando-server:{version}     - Docker image (publish profile only)
// =============================================================================

// Define profiles
var publish = DefineProfile("publish");
var docs = DefineProfile("docs");
var e2e = DefineProfile("e2e");

// Docs-only profile: just deploy the website and exit early
if (docs && !publish)
{
    Log.Info("Deploying documentation website to Cloudflare...");
    Ando.Build(Directory("./website"), o => o.WithProfile("publish"));
    return;
}

// Detect if running on Ando.Server (vs local ando CLI)
// ANDO_HOST_ROOT is only set when running on Ando.Server
var isOnServer = Env("ANDO_HOST_ROOT", required: false) != null;

var project = Dotnet.Project("./src/Ando/Ando.csproj");
// Also referenced so `ando bump` (and therefore `ando release`) keeps the server assembly version in sync.
// The server is built here to catch compile errors early (Ando.sln does not include it);
// the published image is still produced by the Docker build.
var serverProject = Dotnet.Project("./src/Ando.Server/Ando.Server.csproj");
var serverTestProject = Dotnet.Project("./tests/Ando.Server.Tests/Ando.Server.Tests.csproj");
var testProject = Dotnet.Project("./tests/Ando.Tests/Ando.Tests.csproj");

// Get version from the project file.
var version = project.Version;
Log.Info($"Building version: {version}");

// Base output directory
var distPath = Root / "dist";

// Install .NET SDK
Dotnet.SdkInstall();

// The unit tests create real git repositories, so git must exist in the build container
// (the default image has none, and --dind only brings it in as a docker.io recommendation).
Git.Install();

// Restore dependencies
Dotnet.Restore(project);

// Build the project
Dotnet.Build(project);

// Run .NET tests (exclude E2E - they have a separate step below)
Dotnet.Test(testProject, o => o.Filter = "Category!=E2E");

// Build the server and its test project (not part of Ando.sln).
Dotnet.Build(serverProject);
Dotnet.Build(serverTestProject);

// Server unit tests, including the EF migration drift tests for both providers.
// No Docker needed, so these always run.
Dotnet.Test(serverTestProject, o => o.Filter = "Category!=Integration");

// =============================================================================
// Server Tests + E2E Tests (Playwright)
//
// Server integration tests (Category=Integration) use Testcontainers
// (SQL Server, PostgreSQL), so they share the Docker gate with E2E.
//
// E2E tests use docker-compose to spin up a database and web server containers,
// once per provider: SQL Server, then PostgreSQL (E2E_DB_PROVIDER=postgres via
// the `test:postgres` npm script).
// The tests connect via host.docker.internal when running inside an ANDO container.
//
// - Locally: Run automatically if Docker available (detected via absence of ANDO_HOST_ROOT)
// - On Ando.Server: Skipped by default (use -p e2e to force)
// - publish profile: Always required; the build fails if Docker is not available
//
// IMPORTANT: Run with `ando --dind` to enable Docker-in-Docker mode.
// This gives the build container access to the host's Docker daemon.
// =============================================================================
var e2eTests = Directory("./tests/Ando.Server.E2E");

// Check if we should run E2E tests (mandatory for releases)
var shouldRunE2E = !isOnServer || e2e || publish;

if (shouldRunE2E)
{
    // Check if Docker is available (requires --dind flag when running ando)
    if (!Docker.IsAvailable())
    {
        if (publish)
        {
            throw new Exception(
                "Docker is not available: the publish profile requires the server integration tests " +
                "and the SQL Server + PostgreSQL E2E tests. Run with 'ando --dind -p publish'.");
        }

        Log.Warning("Skipping server integration tests and E2E tests (Docker not available - run with 'ando --dind' to enable)");
    }
    else
    {
        // Install Docker CLI (needed for Testcontainers and docker-compose)
        Docker.Install();

        // Server integration tests (Testcontainers) against both SQL Server and
        // PostgreSQL. ANDO_TEST_DB_PROVIDERS defaults to both providers; do not
        // narrow it here. The fixtures default to isolated containers (unique
        // names, random ports, cleanup) whenever the tests run inside a container
        // or CI / ANDO_HOST_ROOT is set, so builds that share a Docker daemon are
        // safe without extra configuration.
        // A release must cover both providers: refuse a narrowed matrix from .env.ando.
        var providerOverride = Env("ANDO_TEST_DB_PROVIDERS", required: false);
        if (publish && providerOverride != null && providerOverride.Replace(" ", "") != "SqlServer,PostgreSql")
        {
            throw new Exception($"ANDO_TEST_DB_PROVIDERS is set to '{providerOverride}'. A publish build must run both providers; unset it or set it to 'SqlServer,PostgreSql'.");
        }

        Log.Info("Running Ando.Server integration tests (SQL Server + PostgreSQL)...");
        Dotnet.Test(serverTestProject, o => o.Filter = "Category=Integration");

        Log.Info("Running Playwright E2E tests...");

        // Install npm dependencies
        Npm.Ci(e2eTests);

        // Install Playwright browsers
        Playwright.Install(e2eTests);

        // Run E2E tests against SQL Server, then PostgreSQL. Both scripts set
        // E2E_DB_PROVIDER explicitly so an inherited value cannot run one provider twice.
        // Exit code propagates - test failures will fail the build
        Playwright.Test(e2eTests, o =>
        {
            o.UseNpmScript = true;
            o.NpmScriptName = "test:sqlserver";
        });
        Playwright.Test(e2eTests, o =>
        {
            o.UseNpmScript = true;
            o.NpmScriptName = "test:postgres";
        });
    }
}
else
{
    Log.Info("Skipping server integration tests and E2E tests (running on Ando.Server - use -p e2e to override)");
}

// Publish for multiple platforms
var runtimes = new[] { "win-x64", "win-arm64", "linux-x64", "linux-arm64", "osx-x64", "osx-arm64" };

foreach (var runtime in runtimes)
{
    Log.Info($"Publishing for {runtime}...");
    var outputDir = distPath / runtime;

    Dotnet.Publish(project, o => o
        .WithRuntime(runtime)
        .Output(outputDir)
        .AsSelfContained()
        .AsSingleFile());
}

// Create NuGet package for the dotnet tool
Nuget.Pack(project);

// Push to NuGet.org, container registry, and deploy website (only with publish profile)
if (publish)
{
    // Push to NuGet (skip if version already exists)
    Nuget.EnsureAuthenticated();
    Nuget.Push(project, o => o.SkipDuplicates());

    // Install Docker CLI (needed for --dind mode)
    Docker.Install();

    // Build multi-arch image and push to ghcr.io in one atomic operation.
    // Using WithPush() ensures both version and latest tags point to the same manifest,
    // avoiding cache staleness issues that can occur with separate build/push steps.
    Log.Info("Building and pushing Docker image...");
    Docker.Build("./src/Ando.Server/Dockerfile", o => o
        .WithPlatforms("linux/amd64", "linux/arm64")
        .WithTag($"ghcr.io/aduggleby/ando-server:{version}")
        .WithTag("ghcr.io/aduggleby/ando-server:latest")
        .WithContext(".")
        .WithPush());

    // Tag git repo with version (skip if already exists)
    Git.Tag($"v{version}", o => o.WithSkipIfExists());
    Git.Push();
    Git.PushTags();

    // Create GitHub release with binaries
    // Resolve release assets dynamically because output filenames can vary by runtime
    // (for example, apphost/no-apphost or platform-specific extensions).
    var releaseAssets = new List<string>();
    var hostRoot = Env("ANDO_HOST_ROOT", required: false);

    string? ResolveAssetPath(params string[] candidates)
    {
        foreach (var candidate in candidates)
        {
            // Check candidate in current workspace.
            var workspacePath = Path.GetFullPath(candidate);
            if (File.Exists(workspacePath))
            {
                return workspacePath;
            }

            // Also check host-mapped path when running with dind on Ando.Server.
            if (!string.IsNullOrWhiteSpace(hostRoot))
            {
                var trimmed = candidate.TrimStart('.', '/', '\\');
                var hostPath = Path.GetFullPath(Path.Combine(hostRoot, trimmed));
                if (File.Exists(hostPath))
                {
                    return hostPath;
                }
            }
        }

        return null;
    }

    void AddReleaseAsset(string runtime, bool windows)
    {
        var resolved = ResolveAssetPath(
            $"./dist/{runtime}/ando.exe",
            $"./dist/{runtime}/ando");

        if (resolved != null)
        {
            releaseAssets.Add(resolved);
        }
        else
        {
            Log.Warning($"Release asset missing for {runtime} (expected ando{(windows ? ".exe" : "")})");
        }
    }

    AddReleaseAsset("win-x64", windows: true);
    AddReleaseAsset("win-arm64", windows: true);
    AddReleaseAsset("linux-x64", windows: false);
    AddReleaseAsset("linux-arm64", windows: false);
    AddReleaseAsset("osx-x64", windows: false);
    AddReleaseAsset("osx-arm64", windows: false);

    if (releaseAssets.Count == 0)
    {
        Log.Warning("No release binaries were found. Creating GitHub release without assets.");
    }

    // Files are renamed during upload to include runtime for uniqueness.
    GitHub.CreateRelease(o => o
        .WithTag(version)
        .WithGeneratedNotes()
        .WithFiles(releaseAssets.ToArray()));

    // Build and deploy the documentation website.
    // API docs are generated via `ando docs` pre-hook.
    // Ando.Server builds should not depend on external docs deployment credentials;
    // use the explicit `docs` profile when deploying docs from a controlled environment.
    if (!isOnServer)
    {
        Ando.Build(Directory("./website"), o => o.WithProfile("publish"));
    }
    else
    {
        Log.Info("Skipping documentation website deploy (disabled on Ando.Server builds).");
    }
}

// Copy the dist folder from container to host both individually and as a compressed archive
Ando.CopyArtifactsToHost("dist", "./dist");
Ando.CopyZippedArtifactsToHost("dist", "./dist/ando-binaries.zip");
